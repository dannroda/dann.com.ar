---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { posts, slugOf } from '../../../posts';
import { t, url, other, langs, fmtDate, type Lang } from '../../../i18n';

export async function getStaticPaths() {
	const paths = [];
	for (const lang of langs) {
		const translated = new Set((await posts(other(lang))).map((p) => slugOf(p.id)));
		for (const post of await posts(lang)) {
			const slug = slugOf(post.id);
			paths.push({ params: { lang, slug }, props: { post, translated: translated.has(slug) } });
		}
	}
	return paths;
}

const lang = Astro.params.lang as Lang;
const s = t[lang];
const { post, translated } = Astro.props;
const { Content } = await render(post);
const slug = slugOf(post.id);
---

<!-- A post may exist in one language only; then the switch goes to the other blog's index. -->
<Base lang={lang} title={post.data.title} path={translated ? `blog/${slug}/` : 'blog/'}>
	<article class="section">
		<a class="mono" href={url(`/${lang}/blog/`)}>← {s.blog.toUpperCase()}</a>
		<p class="mono">{fmtDate(post.data.date, lang)}{post.data.draft && ` · ${s.draft.toUpperCase()}`}</p>
		<h1 style="font-size: clamp(36px, 5vw, 60px); font-weight: 800; max-width: 22ch">{post.data.title}</h1>
		{post.data.description && <p class="sub muted" style="font-size: 21px; max-width: 52ch">{post.data.description}</p>}
		<div class="prose"><Content /></div>
		{
			post.data.tags.length > 0 && (
				<div class="pills">
					{post.data.tags.map((tag) => <a class="pill" href={url(`/${lang}/blog/tags/${tag}/`)}>#{tag}</a>)}
				</div>
			)
		}
	</article>
</Base>
