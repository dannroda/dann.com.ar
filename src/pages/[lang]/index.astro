---
import Base from '../../layouts/Base.astro';
import AiTag from '../../components/AiTag.astro';
import profile from '../../../content/profile.json';
import { games, list, type Game } from '../../games';
import { posts, slugOf } from '../../posts';
import { t, url, fmtDate, langPaths, type Lang } from '../../i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const s = t[lang];
const { published, jams, other, projects, lab } = await games();
const latest = (await posts(lang)).slice(0, 3);
// Your own summary wins over the store's; the store text may only exist in English.
const blurb = (g: Game) => g.own?.summary[lang] || g.data.short?.[lang] || g.data.short?.en || g.data.description;
const href = (g: Game) => url(`/${lang}/games/${g.id}/`);
---

<Base lang={lang}>
	<section class="hero">
		<p class="mono">DANIEL RODRIGUEZ AIRES · ARGENTINA</p>
		<h1>{s.tagline}<span class="accent">.</span></h1>
		<p class="sub">{s.sub}</p>
		<div class="pills">
			{profile.links.map((l) => <a class="pill" href={l.url}>{l.label} <span aria-hidden="true" class="muted">↗</span></a>)}
		</div>
	</section>

	<section class="legend" aria-labelledby="legend">
		<h2 id="legend" class="mono">{s.legendTitle.toUpperCase()}</h2>
		<div class="legend-grid">
			{
				(['hand', 'assisted', 'vibe'] as const).map((k) => (
					<div>
						<span class={`tag ${k}`}>{s.legend[k][0]}</span>
						<p>{s.legend[k][1]}</p>
					</div>
				))
			}
		</div>
	</section>

	{
		published.length > 0 && (
			<section id="games" class="section" aria-labelledby="h-games">
				<div class="section-head">
					<h2 id="h-games">{s.published}</h2>
				</div>
				<div class="cards">
					{published.map((g) => (
						<article class="card">
							{g.data.local_images.cover && <img class="shot" src={url(g.data.local_images.cover)} alt="" loading="lazy" />}
							<div class="pills">
								<AiTag lang={lang} level={g.own?.ai} />
								<span class="mono">{[...(g.data.genres ?? []), g.data.release_date?.slice(-4)].filter(Boolean).join(' · ').toUpperCase()}</span>
							</div>
							<h3>{g.data.title}</h3>
							<p>{blurb(g)}</p>
							<div class="pills">
								<a class="pill" href={g.data.url}>Steam <span aria-hidden="true" class="muted">↗</span></a>
								<a class="pill" href={url(`/${lang}/games/${g.id}/`)}>{s.details} →</a>
							</div>
						</article>
					))}
				</div>
			</section>
		)
	}

	{
		jams.length > 0 && (
			<section id="jams" class="section" aria-labelledby="h-jams">
				<div class="section-head">
					<h2 id="h-jams">{s.jams}</h2>
					<a class="mono" href="https://dannroda.itch.io/">{s.allOnItch.toUpperCase()} ↗</a>
				</div>
				<div class="rows">
					{jams.map((g) => (
						<a class="row" href={url(`/${lang}/games/${g.id}/`)}>
							<span class="title">{g.data.title}</span>
							<span class="meta">
								{g.data.jam?.name}
								{g.data.jam?.theme && ` · “${g.data.jam.theme}”`}
							</span>
							<span class="mono">{g.data.jam?.results?.Overall && `${s.rank} #${g.data.jam.results.Overall.rank}`}</span>
							<span><AiTag lang={lang} level={g.own?.ai} /></span>
						</a>
					))}
				</div>
			</section>
		)
	}

	{
		other.length > 0 && (
			<section class="section" aria-labelledby="h-other">
				<div class="section-head">
					<h2 id="h-other">{s.other}</h2>
				</div>
				<div class="rows">
					{other.map((g) => (
						<a class="row" href={url(`/${lang}/games/${g.id}/`)}>
							<span class="title">{g.data.title}</span>
							<span class="meta">{list(g.data.info?.['Made with'])}</span>
							<span class="mono" />
							<span><AiTag lang={lang} level={g.own?.ai} /></span>
						</a>
					))}
				</div>
			</section>
		)
	}

	{
		projects.length > 0 && (
			<section id="projects" class="section" aria-labelledby="h-projects">
				<div class="section-head">
					<h2 id="h-projects">{s.projects}</h2>
					<p class="mono">{s.projectsSub.toUpperCase()}</p>
				</div>
				<div class="tiles">
					{projects.map((g) => (
						<a class="tile" href={href(g)}>
							<AiTag lang={lang} level={g.own?.ai} />
							<span class="tile-title">{g.data.title}</span>
							<span class="muted">{blurb(g)}</span>
							<span class="mono">{[g.data.language, ...(g.data.topics ?? [])].filter(Boolean).join(' · ').toUpperCase()}</span>
						</a>
					))}
				</div>
			</section>
		)
	}

	<section id="lab" class="lab" aria-labelledby="h-lab">
		<div class="section-head">
			<div style="display: flex; flex-direction: column; gap: 10px; max-width: 60ch">
				<h2 id="h-lab" class="lab-title">Lab/<span class="muted">vibe-coded</span></h2>
				<p class="muted">{s.labIntro}</p>
			</div>
			<span class="tag vibe">{s.legend.vibe[0]}</span>
		</div>
		{
			lab.length > 0 && (
				<div class="lab-grid">
					{lab.map((g) => (
						<a href={href(g)}>
							<span>{g.data.title}</span>
							<span class="mono">{[g.data.language, g.data.created?.slice(0, 4)].filter(Boolean).join(' · ')}</span>
						</a>
					))}
				</div>
			)
		}
	</section>

	{
		latest.length > 0 && (
			<section id="blog" class="section" aria-labelledby="h-blog">
				<div class="section-head">
					<h2 id="h-blog">{s.latest}</h2>
					<a class="mono" href={url(`/${lang}/blog/`)}>{s.allPosts.toUpperCase()} →</a>
				</div>
				<div class="rows">
					{latest.map((p) => (
						<a class="row post-row" href={url(`/${lang}/blog/${slugOf(p.id)}/`)}>
							<span class="mono">{fmtDate(p.data.date, lang)}</span>
							<span class="title">{p.data.title}</span>
							<span class="mono">{p.data.tags.map((x) => `#${x}`).join(' ')}</span>
						</a>
					))}
				</div>
			</section>
		)
	}
</Base>
