---
import Base from '../../layouts/Base.astro';
import AiTag from '../../components/AiTag.astro';
import Monument from '../../components/Monument.astro';
import profile from '../../../content/profile.json';
import { games, list, type Game } from '../../games';
import { posts, slugOf } from '../../posts';
import { t, url, other, langPaths, type Lang } from '../../i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const s = t[lang];
const alt = other(lang);
const { all, published, jams, other: otherGames, projects, lab } = await games();
const latest = (await posts(lang))[0];
const href = (g: Game) => url(`/${lang}/games/${g.id}/`);
const ai = (g: Game) => g.own?.ai || 'none';
const blurb = (g: Game) => g.own?.summary[lang] || g.data.short?.[lang] || g.data.short?.en || g.data.description;

const lead = published[0];
const shots = lead ? [...lead.data.local_images.screenshots, lead.data.local_images.cover].filter(Boolean).slice(0, 4) as string[] : [];
const counts = { all: all.length, hand: all.filter((g) => g.own?.ai === 'hand').length, ai: all.filter((g) => g.own?.ai === 'assisted' || g.own?.ai === 'vibe').length };
const names = [...projects, ...otherGames];
---

<Base lang={lang} mode="home">
	<div class="home">
		<section class="hero" aria-label="dann">
			<div class="hero-top">
				<div class="hero-intro">
					<p>{s.heroIntro}</p>
				</div>
				<nav class="nav" aria-label={s.navLabel}>
					<a href="#games">{s.nav.games}</a>
					<a href="#projects">{s.nav.projects}</a>
					<a href={url(`/${lang}/blog/`)}>{s.nav.blog}</a>
					<a href={url(`/${alt}/`)} hreflang={alt} lang={alt}>{alt.toUpperCase()}</a>
				</nav>
			</div>
			<Monument as="h1" label={s.tagline} />
			<div class="hero-bottom">
				<p>{s.place}</p>
				<div class="hero-links">{profile.links.map((l) => <a href={l.url}>{l.label} ↗</a>)}</div>
			</div>
		</section>

		<section id="games" class="works-sec" aria-labelledby="h-games">
			<div class="works-head">
				<h2 id="h-games" data-rise>{s.nav.games}</h2>
				<div class="filter" role="group" aria-labelledby="filter-label" hidden>
					<span id="filter-label" class="small">{s.filterLabel}</span>
					<button type="button" data-filter="all" aria-pressed="true">{s.filterAll} <span>{counts.all}</span></button>
					<button type="button" data-filter="hand" aria-pressed="false">{s.filterHand} <span>{counts.hand}</span></button>
					<button type="button" data-filter="ai" aria-pressed="false">{s.filterAi} <span>{counts.ai}</span></button>
				</div>
			</div>
			<p class="legend-lead">{s.legendLead}</p>
			<div class="works">
				{
					lead && (
						<article class="work lead" data-ai={ai(lead)} data-rise>
							<a class="work-img" href={href(lead)} tabindex="-1" aria-hidden="true">
								<img src={url(shots[0])} alt="" width="1600" height="900" />
							</a>
							<div class="work-body">
								<div class="work-title">
									<h3><a href={href(lead)}>{lead.data.title}</a></h3>
									<AiTag lang={lang} level={lead.own?.ai} />
								</div>
								<p class="small">{[s.published, lead.data.release_date?.slice(-4), lead.own?.role[lang]].filter(Boolean).join(' · ')}</p>
								<p class="work-text" lang={lead.own?.summary[lang] || lead.data.short?.[lang] ? lang : 'en'}>{blurb(lead)}</p>
								<span class="pills">
									<a class="pill primary" href={lead.data.url}>Steam ↗</a>
									<a class="pill" href={href(lead)}>{s.details} →</a>
								</span>
							</div>
						</article>
					)
				}
				{
					jams.map((g) => (
						<a class="work" href={href(g)} data-ai={ai(g)} data-rise>
							<span class="work-img">
								{g.data.local_images.cover && <img src={url(g.data.local_images.cover)} alt="" loading="lazy" width="630" height="500" />}
								{g.data.jam?.results?.Overall && (
									<span class="work-rank">
										#{g.data.jam.results.Overall.rank}
										{g.data.jam.entries && <span> {s.of} {g.data.jam.entries}</span>}
									</span>
								)}
							</span>
							<span class="work-title">
								<span class="work-name">{g.data.title}</span>
								<AiTag lang={lang} level={g.own?.ai} />
							</span>
							<span class="small">
								{g.data.jam?.name}
								{g.data.jam?.theme && ` · “${g.data.jam.theme}”`}
							</span>
							{g.own?.role[lang] && <span class="small">{s.role}: {g.own.role[lang]}</span>}
						</a>
					))
				}
			</div>
		</section>

		{
			names.length > 0 && (
				<section id="projects" class="works-sec" aria-labelledby="h-projects">
					<div class="works-head">
						<h2 id="h-projects" data-rise>{s.projects}</h2>
						<p class="small">{s.projectsCount(projects.length, otherGames.length)}</p>
					</div>
					<div class="works projects">
						{names.map((g) => (
							<a class="work" href={href(g)} data-ai={ai(g)} data-rise>
								<span class="work-img">
									{g.data.local_images.cover && <img src={url(g.data.local_images.cover)} alt="" loading="lazy" width="1200" height="600" />}
								</span>
								<span class="work-title">
									<span class="work-name">{g.data.title}</span>
									<AiTag lang={lang} level={g.own?.ai} />
								</span>
								<span class="small">{[g.data.language ?? list(g.data.info?.['Made with']), g.data.created?.slice(0, 4)].filter(Boolean).join(' · ')}</span>
								{blurb(g) && <span class="work-text">{blurb(g)}</span>}
							</a>
						))}
					</div>
				</section>
			)
		}

		{
			lab.length > 0 && (
				<section id="lab" class="lab-sec" aria-labelledby="h-lab">
					<h2 id="h-lab" class="lab-word" data-rise>Lab</h2>
					<div class="lab-side">
						<span class="tag vibe" data-rise>{s.legend.vibe[0]}</span>
						<p data-rise>{s.labIntro}</p>
						<div class="lab-bars" data-rise>
							{lab.map((g) => (
								<a href={href(g)} data-ai="vibe">
									<span>{g.data.title}</span>
									<span>→</span>
								</a>
							))}
						</div>
					</div>
				</section>
			)
		}

		<section class="about-sec" aria-labelledby="h-about">
			<div class="about-facts">
				<h2 id="h-about" data-rise>{s.about}</h2>
				{s.facts.map(([k, v]) => <p data-rise><span>{k}</span>{v}</p>)}
				{latest && <p data-rise><span>{s.blog}</span><a href={url(`/${lang}/blog/${slugOf(latest.id)}/`)}>{latest.data.title}</a></p>}
			</div>
			<div class="about-text">
				{s.aboutText.map((p) => <p data-rise>{p}</p>)}
			</div>
		</section>
	</div>
</Base>
