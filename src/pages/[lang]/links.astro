---
import Base from '../../layouts/Base.astro';
import profile from '../../../content/profile.json';
import { t, url, other, langPaths, type Lang } from '../../i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const s = t[lang];
const alt = other(lang);
---

<Base lang={lang} title={s.linksTitle} path="links/" mode="bare">
	<div class="links-page">
		<h1><a class="wordmark" href={url(`/${lang}/`)}>dann</a></h1>
		<p class="muted">{s.tagline}.</p>
		<nav aria-label={s.linksTitle} data-rise>
			{profile.links.map((l) => <a href={l.url}><span>{l.label}</span><span aria-hidden="true">↗</span></a>)}
			<a href={url(`/${lang}/`)}><span>{s.portfolio}</span><span aria-hidden="true">→</span></a>
		</nav>
		<a class="small" style="margin-top: auto; padding: 12px 0" href={url(`/${alt}/links/`)} hreflang={alt} lang={alt}>{alt.toUpperCase()}</a>
	</div>
</Base>
