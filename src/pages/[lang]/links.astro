---
import Base from '../../layouts/Base.astro';
import profile from '../../../content/profile.json';
import { t, url, other, langPaths, type Lang } from '../../i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const s = t[lang];
const alt = other(lang);
---

<Base lang={lang} title={s.linksTitle} path="links/" bare>
	<div class="links">
		<a class="brand" href={url(`/${lang}/`)} style="font-size: 34px; font-family: 'Archivo', sans-serif; font-weight: 800">dann<span>_</span></a>
		<p class="muted">{s.tagline}.</p>
		<nav aria-label={s.linksTitle}>
			{profile.links.map((l) => <a href={l.url}><span>{l.label}</span><span aria-hidden="true">↗</span></a>)}
			<a href={url(`/${lang}/`)}><span>{s.portfolio}</span><span aria-hidden="true">→</span></a>
		</nav>
		<a class="mono" style="margin-top: auto; padding: 12px 0" href={url(`/${alt}/links/`)} hreflang={alt} lang={alt}>{alt.toUpperCase()}</a>
	</div>
</Base>
