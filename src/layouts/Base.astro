---
import '../styles/global.css';
import { t, other, url, type Lang } from '../i18n';

interface Props {
	lang: Lang;
	title?: string;
	// path after /<lang>/, so the language switch lands on the same page
	path?: string;
	bare?: boolean;
}
const { lang, title, path = '', bare = false } = Astro.props;
const s = t[lang];
const alt = other(lang);
const pageTitle = title ? `${title} · dann` : 'dann';
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<meta name="description" content={`${s.tagline}. ${s.sub}`} />
		<link rel="alternate" hreflang={alt} href={new URL(url(`/${alt}/${path}`), Astro.site)} />
		<link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
		<link rel="alternate" type="application/rss+xml" title={`dann · ${s.blog}`} href={url(`/${lang}/rss.xml`)} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
	</head>
	<body>
		{
			bare ? (
				<slot />
			) : (
				<div class="wrap">
					<header class="header">
						<a class="brand" href={url(`/${lang}/`)}>dann<span>_</span></a>
						<nav class="nav" aria-label={lang === 'es' ? 'Principal' : 'Main'}>
							<a href={url(`/${lang}/#games`)}>{s.nav.games}</a>
							<a href={url(`/${lang}/#jams`)}>{s.nav.jams}</a>
							<a href={url(`/${lang}/blog/`)}>{s.nav.blog}</a>
							<a href={url(`/${lang}/links/`)}>{s.nav.links}</a>
							<a class="lang" href={url(`/${alt}/${path}`)} hreflang={alt} lang={alt}>{alt.toUpperCase()}</a>
						</nav>
					</header>
					<slot />
					<footer class="footer mono">© {new Date().getFullYear()} Daniel Rodriguez Aires</footer>
				</div>
			)
		}
	</body>
</html>
